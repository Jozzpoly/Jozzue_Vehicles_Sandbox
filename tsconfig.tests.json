{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".e1-test-build",
    "rootDir": ".",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/e1/model.ts",
    "src/e1/spatial.ts",
    "src/e1/edit-session.ts",
    "src/e1/scenario.ts",
    "src/e1/evaluator.ts",
    "src/e1/three-projection.ts",
    "src/v0/math.ts",
    "src/v0/straight-carrier.ts",
    "src/v0/steering-geometry.ts",
    "src/v0/physical-steering-world.ts",
    "src/v0/driving-evidence.ts",
    "src/rep2/suspension-link-world.ts",
    "tests/e1/**/*.ts",
    "tests/v0/**/*.ts",
    "tests/r1/**/*.ts",
    "tests/rep2/**/*.ts"
  ]
}
